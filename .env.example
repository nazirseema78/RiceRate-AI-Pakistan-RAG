# Copy this file to .env and fill in values. NEVER commit .env.
# All values below are placeholders / safe defaults.

ENVIRONMENT=development
LOG_LEVEL=INFO

# Admin token for POST /api/admin/refresh (empty = admin endpoints disabled).
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=
REFRESH_MIN_INTERVAL_SECONDS=120

# Frontend URL(s) allowed to call the API
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
# Used by the Streamlit frontend
BACKEND_URL=http://127.0.0.1:8000

# Market data providers (comma separated):
#   synthetic_demo, csv_import, fscpd_punjab, worldbank_pinksheet, pakdatahub, commercial
ENABLED_PROVIDERS=synthetic_demo,csv_import,fscpd_punjab,worldbank_pinksheet,pakdatahub
LOAD_SYNTHETIC_DEMO_DATA=true

# PakDataHub (AMIS Punjab wholesale prices) - free plan: 500 calls/month, 10 req/min.
# Get a key from https://pakdatahub.com . Leave empty to keep the connector disabled.
PAKDATAHUB_API_KEY=
PAKDATAHUB_MAX_CALLS_PER_RUN=9

# World Bank Pink Sheet monthly workbook (URL changes with each monthly edition)
WORLDBANK_PINKSHEET_URL=https://thedocs.worldbank.org/en/doc/74e8be41ceb20fa0da750cda2f6b9e4e-0050012026/related/CMO-Historical-Data-Monthly.xlsx

# Phase 2 - future commercial provider (not implemented in Phase 1)
COMMERCIAL_PROVIDER_NAME=
COMMERCIAL_PROVIDER_BASE_URL=
COMMERCIAL_PROVIDER_API_KEY=

# Scheduler (Pakistan Standard Time)
SCHEDULER_ENABLED=true
SCHEDULER_HOURS=9,12,15,18

# RAG
EMBEDDING_BACKEND=sentence_transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RETRIEVAL_K=5

# AI models: the easiest way is the Settings (Admin) page in the app, which supports several free and paid
# providers with automatic fallback (saved in storage/provider_settings.json, git-ignored).
# The single-provider setup below still works and is tried after the Settings-page providers.
# Optional LLM (OpenAI-compatible endpoint). none = retrieval-only answers (works offline).
# Free local option: install Ollama, run `ollama pull llama3.2`, then set:
#   LLM_PROVIDER=openai_compatible  LLM_BASE_URL=http://localhost:11434/v1  LLM_MODEL=llama3.2
LLM_PROVIDER=none
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=
LLM_MODEL=llama3.2
